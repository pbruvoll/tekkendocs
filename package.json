{
  "name": "tekkendocs",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:sitemap": "remix-sitemap",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "dev": "node ./server.js",
    "dev-mock-data": "cross-env USE_MOCK_DATA=1 remix dev --manual -c \"node server.js\"",
    "start": "cross-env NODE_ENV=production node ./server.js",
    "setup": "prisma generate && prisma migrate deploy",
    "setup:db:dev": "prisma migrate reset && prisma migrate dev",
    "test": "vitest",
    "lint": "biome lint",
    "lint:supress-warnings": "biome lint --diagnostic-level=error",
    "lint:fix": "biome lint --fix",
    "format": "biome format --write",
    "formatcheck": "biome format .",
    "formatcheck-windows": "biome format --line-ending=crlf .",
    "validate": "run-p \"test -- --run\" lint typecheck",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@prisma/client": "^5.18.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/themes": "^3.2.1",
    "@react-router/express": "^8.3.0",
    "@react-router/fs-routes": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@tanstack/react-virtual": "^3.13.18",
    "cachified": "^3.5.4",
    "class-variance-authority": "^0.7.0",
    "classix": "^2.1.35",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "express": "^5.2.1",
    "googleapis": "^167.0.0",
    "isbot": "^4.1.0",
    "lru-cache": "^10.0.1",
    "lucide-react": "^0.546.0",
    "morgan": "^1.10.0",
    "motion": "^12.23.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.0.1",
    "react-player": "^2.16.0",
    "react-router": "^8.3.0",
    "remix-utils": "^10.0.0",
    "shadcn": "^3.7.0",
    "tailwind-merge": "^2.3.0",
    "tiny-invariant": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^27.2.0",
    "prisma": "^5.18.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.1.5"
  },
  "eslintIgnore": [
    "node_modules",
    "build",
    "public/build"
  ],
  "engines": {
    "node": ">=22.22.0"
  }
}
