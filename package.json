{
  "name": "tekkendocs",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install || exit 0",
    "build": "react-router build",
    "build:sitemap": "remix-sitemap",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "dev": "cross-env NODE_ENV=development node --conditions development ./server.js",
    "dev-mock-data": "cross-env USE_MOCK_DATA=1 NODE_ENV=development node --conditions development ./server.js",
    "start": "cross-env NODE_ENV=production node ./server.js",
    "setup": "prisma generate && prisma migrate deploy",
    "setup:db:dev": "prisma migrate reset && prisma migrate dev",
    "test": "vitest",
    "lint": "biome lint",
    "lint:supress-warnings": "biome lint --diagnostic-level=error",
    "lint:fix": "biome lint --fix",
    "format": "biome format --write",
    "formatcheck": "biome format .",
    "formatcheck-windows": "biome format --line-ending=crlf .",
    "validate": "run-p \"test -- --run\" lint typecheck",
    "typecheck": "react-router typegen && tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@epic-web/cachified": "^5.6.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@prisma/client": "^5.18.0",
    "@react-router/express": "^8.4.0",
    "@react-router/fs-routes": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@tanstack/react-virtual": "^3.13.18",
    "class-variance-authority": "^0.7.0",
    "cn": "^0.4.0",
    "compression": "^1.8.1",
    "cross-env": "^10.0.0",
    "express": "^5.2.1",
    "googleapis": "^167.0.0",
    "isbot": "^5.1.36",
    "lru-cache": "^11.5.2",
    "lucide-react": "^1.56.0",
    "morgan": "^1.10.1",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.0.1",
    "react-player": "^2.16.0",
    "react-router": "^8.4.0",
    "remix-utils": "^10.0.0",
    "shadcn": "^4.22.1",
    "tiny-invariant": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/morgan": "^1.9.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.0",
    "prisma": "^5.18.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.7"
    }
  }
}
